					"script": {
						"exec": [
							"// Obtener data una sola vez\r",
							"var jsonData = pm.response.json();\r",
							"\r",
							"pm.test(\"Status code is 200\" , function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Verificar que depositpaid es true\", function () {\r",
							"    pm.expect(jsonData.booking.depositpaid).to.be.true;\r",
							"});\r",
							"\r",
							"pm.test(\"Verificar bookingId\", function () {\r",
							"    pm.environment.set(\"bookingId\", jsonData.bookingid);\r",
							"    pm.expect(jsonData.bookingid).to.not.be.null;\r",
							"});\r",
							"\r",
							"pm.test(\"Verificar booking firstname\", function () {\r",
							"    pm.environment.set(\"firstName\", jsonData.booking.firstname);\r",
							"    pm.expect(jsonData.booking.firstname).to.not.be.empty;\r",
							"});\r",
							"\r",
							"pm.test(\"Verificar booking lastname\", function () {\r",
							"    pm.environment.set(\"lastName\", jsonData.booking.lastname);\r",
							"    pm.expect(jsonData.booking.lastname).to.not.be.empty;\r",
							"});\r",
							"\r",
							"pm.test(\"Verificar precio\", function () {\r",
							"    pm.environment.set(\"Price\", jsonData.booking.totalprice);\r",
							"    pm.expect(jsonData.booking.totalprice).to.not.be.null;\r",
							"});\r",
							""
						],
