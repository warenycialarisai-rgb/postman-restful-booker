		{
			"name": "Update Booking",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"function generateRandomNumber() {\r",
							"    const min = 100;\r",
							"    const max = 999;\r",
							"    return Math.floor(Math.random() * (max - min + 1)) + min;\r",
							"}\r",
							"\r",
							"const randomPrice = generateRandomNumber();\r",
							"\r",
							"pm.environment.set('randomPrice', randomPrice);\r",
							"\r",
							"console.log('Random Generated Price:', randomPrice);\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"pm.test(\"Price was updates correctly\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    var updatePrice = pm.environment.get(\"randomPrice\");\r",
							"    pm.expect(jsonData.totalprice).to.eql(updatePrice);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
