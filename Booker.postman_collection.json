		{
			"name": "Booking",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"pm.test(\"Verificar que depositpaid es true\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.depositpaid).to.be.true;\r",
							"});\r",
							"pm.test(\"Verificar que el firstName es el creado\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    var current_FirstName = jsonData.firstname;\r",
							"    var expected_FirstName = pm.environment.get(\"firstName\");\r",
							"    console.log(\"Current value is \"+ current_FirstName+\" and the expeced value is \"+expected_FirstName);\r",
							"    pm.expect(current_FirstName).to.eql(expected_FirstName);\r",
							"});\r",
							"pm.test(\"Verificar que el lastName es el creado\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    var current_LastName = jsonData.lastname;\r",
							"    var expected_LasttName = pm.environment.get(\"lastName\");\r",
							"    console.log(\"Current value is \"+ current_LastName+\" and the expeced value is \"+expected_LasttName);\r",
							"    pm.expect(current_LastName).to.eql(expected_LasttName);\r",
							"});\r",
							"pm.test(\"Verificar que el precio es el creado\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    var current_Price = jsonData.totalprice;\r",
							"    var expected_Price = pm.environment.get(\"Price\");\r",
							"     console.log(\"Current value is \"+ current_Price+\" and the expeced value is \"+expected_Price);\r",
							"    pm.expect(current_Price).to.eql(expected_Price);\r",
							"});\r",
							"\r",
							""
						],
